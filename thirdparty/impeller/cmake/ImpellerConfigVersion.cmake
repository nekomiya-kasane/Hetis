set(PACKAGE_VERSION "1.4.0")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)

# Impeller does not guarantee API/ABI compatibility across API versions.
if(PACKAGE_FIND_VERSION_RANGE)
    if(PACKAGE_FIND_VERSION_MIN VERSION_EQUAL PACKAGE_VERSION
       AND PACKAGE_FIND_VERSION_MAX VERSION_EQUAL PACKAGE_VERSION
       AND PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE")
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
elseif(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    set(PACKAGE_VERSION_EXACT TRUE)
endif()

if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
